# Git ignore rules for Gaudeix Codex.

# Python bytecode
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
wheels/

# Python lib/ folders (but allow frontend/backoffice src/lib/)
backend/lib/
**/site-packages/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
.hypothesis/
.pytest_cache/
.pytest_tmp/
coverage.xml
nosetests.xml

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Environments / virtualenvs
.env
.envrc
.venv/
.venv_win/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment files (keep only examples)
.env_backend
.env_frontend
.env_backoffice
backend/.env
frontend/.env.local
backoffice/.env.local
*.env.local
*.env.production
*.env.development

# Secrets
backend/secrets/
backend/secrets/*.json

# IDEs / tooling
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.cursorignore
.cursorindexingignore
.DS_Store
Thumbs.db

# Node / frontend build artifacts
node_modules/
.pnpm-store/
.turbo/
.vite/
storybook-static/
coverage/
dist/

# Backend generated files and media
backend/*.sqlite3
backend/staticfiles/
backend/media/

# Playwright / E2E outputs
playwright-report/
test-results/
playwright/.cache/
e2e_output.txt

# Deployment / containerization artifacts
docker-compose.override.yml
*.env.docker

# Development plans and drafts
.sisyphus/

#codex tmp files
.codex-tmp-issues/